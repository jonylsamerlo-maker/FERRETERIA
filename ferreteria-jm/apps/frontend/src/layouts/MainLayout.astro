---
import Header from "../components/layout/Header.jsx";
import Footer from "../components/layout/Footer.jsx";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let tema = "light";

        try {
          const claveTema = "tema";
          const temaGuardado = localStorage.getItem(claveTema);

          if (temaGuardado === "dark" || temaGuardado === "light") {
            tema = temaGuardado;
          } else {
            tema = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
        } catch {
          tema = "light";
        }

        document.documentElement.setAttribute("data-theme", tema);
      })();
    </script>
  </head>

  <body>
    <Header client:load />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html[data-theme="light"] {
    --color-page-background: #f3f4f6;
    --color-text-primary: #111827;
    --color-surface: #ffffff;
    --color-border: #e5e7eb;
    --color-text-secondary: #4b5563;
    --color-primary: #c2410c;
    --color-shadow: rgba(17, 24, 39, 0.12);
  }

  html[data-theme="dark"] {
    --color-page-background: #111827;
    --color-text-primary: #f9fafb;
    --color-surface: #1f2937;
    --color-border: #374151;
    --color-text-secondary: #d1d5db;
    --color-primary: #f97316;
    --color-shadow: rgba(0, 0, 0, 0.35);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--color-page-background);
    color: var(--color-text-primary);
  }

  body {
    margin: 0;
    background: var(--color-page-background);
    color: var(--color-text-primary);
  }

  :where(main, section, article, aside, nav, header, footer, div) {
    border-color: var(--color-border);
  }
</style>
