# Copiar a .env solo fuera del repositorio y reemplazar cada placeholder.
APP_ENV=production
NODE_ENV=production

# Origen público definitivo, sin barra final.
FRONTEND_ORIGIN=https://CAMBIAR-POR-ORIGEN-PUBLICO
PUBLIC_API_BASE_URL=https://CAMBIAR-POR-ORIGEN-PUBLICO
SITE_URL=https://CAMBIAR-POR-ORIGEN-PUBLICO
INTERNAL_API_BASE_URL=http://backend
SESSION_COOKIE_SECURE=true
HOST=0.0.0.0
PORT=4321

# Credenciales exclusivas de producción: nunca usar estos valores literales.
MYSQL_DATABASE=ferreteria_db
MYSQL_USER=ferreteria_app
MYSQL_PASSWORD=CAMBIAR-POR-PASSWORD-APLICACION
MYSQL_ROOT_PASSWORD=CAMBIAR-POR-PASSWORD-ROOT
DB_HOST=db
DB_NAME=ferreteria_db
DB_USER=ferreteria_app
DB_PASSWORD=CAMBIAR-POR-PASSWORD-APLICACION
